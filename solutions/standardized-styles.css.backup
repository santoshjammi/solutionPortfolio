.bg-accent     { background-color: var(--meta-blue-light); }

/* ── 19. Responsive: Mobile nav ── */
.mobile-nav-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.65);
  z-index: 50; display: none;
}
.mobile-nav-menu {
  position: fixed; top: 0; left: 0;
  width: 75%; max-width: 300px; height: 100%;
  background: var(--white);
  z-index: 60;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  box-shadow: 2px 0 5px rgba(0,0,0,0.2);
  padding: 1.5rem 1rem;
  overflow-y: auto;
}
.mobile-nav-menu.is-open { transform: translateX(0); }

/* ── 20. Accessibility ── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
.btn:focus,
.faq-question:focus,
.form-input:focus,
.form-textarea:focus,
.form-select:focus {
  outline: 3px solid var(--meta-blue);
  outline-offset: 2px;
}

/* ── 21. Print ── */
@media print {
  .social-share, .share-buttons, #navbar-container,
  .mobile-nav-overlay, .mobile-nav-menu { display: none !important; }
  body { background: white; color: black; }
  .section-dark, .section-navy, .cta-band, .author-section { background: #f1f1f1; color: black; }
}

/* ── 22. Responsive adjustments ── */
@media (max-width: 768px) {
  .share-buttons { flex-direction: column; align-items: center; }
  .hero h1, .hero .hero-title { font-size: 2rem; }
  .display-2 { font-size: 1.75rem; }
  .heading-1 { font-size: 1.5rem; }
  .card { padding: 20px; }
  .container { padding: 0 20px; }
  .content-section .container { padding: 32px 20px; }
  .btn { min-height: 44px; }
}
@media (max-width: 480px) {
  .btn { width: 100%; margin-bottom: 8px; }
}

/* ═══════════════════════════════════════════════════════════════
   Meta Design Overrides — Re-skin Tailwind Arbitrary Values
   Loaded AFTER Tailwind CDN → same specificity wins by cascade.
   ═══════════════════════════════════════════════════════════════ */

/* ── Body ── */
body {
  display: block !important;
  min-height: auto !important;
  background: #F1F4F7;
  color: #1C2B33;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* ── Typography: ensure headings use Meta spec ── */
h1, h2, h3, h4, h5, h6 {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* ── Old brand blue text colors → Meta Blue ── */
[class*="#00449E"]  { color: #0064E0 !important; }
[class*="#005CB9"]  { color: #0064E0 !important; }
[class*="#0076D4"]  { color: #0068E0 !important; }
[class*="#85BDE9"]  { color: #47A5FA !important; }
[class*="#4195D7"]  { color: #47A5FA !important; }

/* ── Old brand blue backgrounds → Meta Blue ── */
[class*="bg-[#00449E]"] { background-color: #0064E0 !important; }
[class*="bg-[#005CB9]"] { background-color: #0064E0 !important; }
[class*="bg-[#0076D4]"] { background-color: #004FBD !important; }
[class*="bg-[#4195D7]"] { background-color: #47A5FA !important; }
[class*="bg-[#85BDE9]"] { background-color: #47A5FA !important; }

/* ── Dark section backgrounds → Near Black ── */
[class*="bg-[#071226]"] { background-color: #1C1E21 !important; }
[class*="bg-[#0A1323]"] { background-color: #1C1E21 !important; }
[class*="bg-[#1a202c]"] { background-color: #1C1E21 !important; }

/* ── Hover state overrides ── */
[class*="hover:bg-[#85BDE9]"]:hover { background-color: #0064E0 !important; color: #fff !important; }
[class*="hover:bg-[#0076D4]"]:hover { background-color: #0143B5 !important; }
[class*="hover:text-[#85BDE9]"]:hover { color: #47A5FA !important; }
[class*="hover:text-[#00449E]"]:hover { color: #0064E0 !important; }

/* ── Card corners: override sharp radii ── */
[class*="rounded-xl"] { border-radius: 20px !important; }
[class*="rounded-2xl"] { border-radius: 24px !important; }
[class*="rounded-lg"] { border-radius: 16px !important; }
[class*="rounded-md"] { border-radius: 8px !important; }

/* ── Button-like elements: pill shape ── */
a[class*="rounded-full"],
button[class*="rounded-full"],
a[class*="rounded-lg"][class*="px-"],
button[class*="rounded-lg"][class*="px-"],
.btn {
  border-radius: 100px !important;
}

/* ── Card shadow upgrade ── */
[class*="shadow-lg"] {
  box-shadow: 0 12px 28px 0 rgba(0,0,0,0.20), 0 2px 4px 0 rgba(0,0,0,0.10) !important;
}
[class*="shadow-md"] {
  box-shadow: 0 2px 4px 0 rgba(0,0,0,0.10) !important;
}

/* ── Section padding standardize ── */
[class*="py-8"]  { padding-top: 32px  !important; padding-bottom: 32px  !important; }
[class*="py-12"] { padding-top: 48px  !important; padding-bottom: 48px  !important; }
[class*="py-16"] { padding-top: 64px  !important; padding-bottom: 64px  !important; }
[class*="py-20"] { padding-top: 80px  !important; padding-bottom: 80px  !important; }

/* ═══════════════════════════════════════════════════════════════
   gradient-bg — Meta dark section (was undefined, now Near Black)
   ═══════════════════════════════════════════════════════════════ */
.gradient-bg {
  background: #1C1E21 !important;
  color: #fff;
}
.gradient-bg h1,
.gradient-bg h2,
.gradient-bg h3,
.gradient-bg h4,
.gradient-bg p,
.gradient-bg li {
  color: rgba(255,255,255,0.90) !important;
}
.gradient-bg .overline {
  color: #47A5FA !important;
}

