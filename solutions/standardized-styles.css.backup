/* ── 4. Buttons ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 400;
  letter-spacing: -0.14px;
  line-height: 1.43;
  text-decoration: none;
  cursor: pointer;
  border: none;
  border-radius: var(--radius-pill);
  padding: 10px 22px;
  min-height: 44px;
  transition: background 200ms ease, color 200ms ease, transform 150ms ease, box-shadow 200ms ease;
  white-space: nowrap;
}

.btn-primary {
  background: var(--meta-blue);
  color: var(--white) !important;
  border: none;
  border-radius: var(--radius-pill);
}
.btn-primary:hover {
  background: var(--meta-blue-hover);
