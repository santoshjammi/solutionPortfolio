/* ── 18. Color utilities ── */
.text-primary  { color: var(--meta-blue); }
.text-accent   { color: var(--meta-blue-ligh.text-accent   { color: var(--meta-blue-ligh.text-accent   { color: var(--meta-blue-ligh.text-accent   { color: var(--meta-blue-ligh.text-accent   { color: var(--meta-blue-ligar(.text-accent   { color: var(--meta-blue-un.text-accent   {ear-black); }
.bg-soft-gray  { background-color: var(--soft-gray); }
