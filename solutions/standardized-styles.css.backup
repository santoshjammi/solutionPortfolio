/* ═══════════════════════════════════════════════════════════════
   Meta Design System — Countrysnews Solutions
   Inspired by Meta Store / Dolly design language
   Shared foundation for all solution pages
   ═══════════════════════════════════════════════════════════════ */

/* ── 1. Design Tokens ── */
:root {
  /* Meta brand blue */
  --meta-blue:          #0064E0;
  --meta-blue-hover:    #0143B5;
  --meta-blue-pressed:  #004BB9;
  --meta-blue-light:    #47A5FA;

  /* Legacy alias (backward-compat) */
  --primary-blue:       #0064E0;
  --accent-blue:        #47A5FA;

  /* Text */
  --dark-charcoal:      #1C2B33;
  --slate-gray:         #5D6C7B;
  --secondary-text:     #65676B;
  --disabled-text:      #BCC0C4;

  /* Surfaces */
  --white:              #FFFFFF;
  --soft-gray:          #F1F4F7;
  --warm-gray:          #F7F8FA;
  --near-black:         #1C1E21;
  --navy:               #071226;
  --light-bg:           #F1F4F7;

  /* Dividers */
  --divider-gray:       #DEE3E9;
  --divider:            #CED0D4;

  /* Border radius */
  --rad  --rad  --rad  --rad  --rad  --rad  --rad--radius-lg:    20px;
  --radius-xl:    24px;
  --radius-pill:  100px;

  /* Shadows */
  --shadow-1:  0 2px 4px 0 rgba(0,0,0,0.10);
  --shadow-2:  0 12px 28px 0 rgba(0,0,0,0.20), 0 2px 4px 0 rgba(0,0,0,0.10);

  /* Spacing */
  --sp-1:  4px;
  --sp-2:  8px;
  --sp-3:  12px;
  --sp-4:  16px;
  --sp-5:  24px;
  --sp-6:  32px;
  --sp-7:  40px;
  --sp-8:  48px;
  --sp-9:  64px;
  --sp-10: 80px;

  /* Legacy spacing aliases */
  --spacing-xs:   0.25rem;
  --spacing-sm:   0.5rem;
  --spacing-md:   1rem;
  --spacing-lg:   1.5rem;
  --spacing-xl:   2rem;
  --spacing-2xl:  3rem;

  /* Font */
  --font: 'Inter', 'Optimistic Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  --font-primary: var(--font);

  /* gray */
  --gray: var(--slate-gray);
  --electric: #6C4BFF;
  --accent: #4F46E5;
}

/* ── 2. Reset & Base ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
html { scroll-behavior: smooth; }
g: border-box; margin: 0; padding:  1.5;
  color: var(--dark-charcoal);
  background: var(--white);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img, video { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }

/* Keep navbar from covering content */
#navbar-container + * { padding-top: 0; }
main { padding-top: 0; }

