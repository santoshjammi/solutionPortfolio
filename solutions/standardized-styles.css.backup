}
.page-hero-banner h1 {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 500;
  line-height: 1.1;
  color: #fff;
  max-width: 800px;
  margin: 0 auto 20px;
  letter-spacing: -0.02em;
}
.page-hero-banner .hero-subtitle {
  font-size: 18px;
  font-weight: 400;
  line-height: 1.6;
  color: rgba(255,255,255,0.70);
  max-width: 600px;
  margin: 0 auto 32px;
}
.page-hero-banner .hero-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}
@media (max-width: 768px) {
  .page-hero-banner { padding: 64px 20px 48px; }
  .page-hero-banner h1 { font-size: 1.875rem; }
  .page-hero-banner .hero-subtitle { font-size: 16px; }
}

/* ── Main content offset for fixed navbar ── */
main.navbar-offset { padding-top: 72px; }
